# Optional. Free key from OpenAlex raises the daily credit budget 10x vs keyless.
# Server-side only — never prefix with NEXT_PUBLIC_.
OPENALEX_API_KEY=

# Optional. Works sampled uniformly at random from the OpenAlex pool (max 10000, per OpenAlex `sample`).
ATLAS_SAMPLE_SIZE=8000

# Optional. Seed makes the sample reproducible across rebuilds.
ATLAS_SEED=7
